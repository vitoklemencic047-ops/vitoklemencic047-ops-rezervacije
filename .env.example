# Lozinka za admin panel (/admin)
ADMIN_PASSWORD=promijeni-me
# Javna adresa aplikacije (za linkove u e-mailovima)
APP_URL=http://localhost:3000
# Tajna za /api/cron/podsjetnici (cron poziva s ?key=...)
CRON_SECRET=promijeni-me
# SMTP (ako nije postavljen, e-mailovi se ispisuju u konzolu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Restoran <rezervacije@example.com>"
