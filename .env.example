# Lozinka za admin panel (/admin)
ADMIN_PASSWORD=promijeni-me
# Javna adresa aplikacije (za linkove u e-mailovima)
APP_URL=http://localhost:3000
# Tajna za /api/cron/podsjetnici (samo ako koristiš vanjski cron, vidi README)
CRON_SECRET=promijeni-me
# SMTP (ako nije postavljen, e-mailovi se ispisuju u konzolu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Restoran <rezervacije@example.com>"

# Twilio za SMS i WhatsApp (ako nije postavljen, poruke se ispisuju u konzolu)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+385...
TWILIO_WHATSAPP_FROM=+14155238886
# Podsjetnici se šalju automatski svakih 5 min; postavi 1 ako koristiš vanjski cron
DISABLE_REMINDER_LOOP=
